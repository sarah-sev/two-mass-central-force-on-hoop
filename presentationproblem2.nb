Cell[TextData[{
 "Two Masses, ",
 Cell[BoxData[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["m", "TI"], "1"], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["m", "TI"], "2"], "\[LongEqual]", 
        StyleBox["m", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
    "m_1=m_2=m", "state" -> "Boxes"|>,
